# UniFlow QA Agent: copy to .env and fill in. NEVER commit .env
# The final evaluation (eval/final_results_v1.1.csv) used Groq openai/gpt-oss-120b.
# Use the same provider and model to reproduce it.
LLM_PROVIDER=groq

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (alternative; free-tier quota ran out during Week 7): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
